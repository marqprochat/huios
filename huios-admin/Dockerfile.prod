# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

ARG NEXT_PUBLIC_PAGBANK_PUBLIC_KEY
ENV NEXT_PUBLIC_PAGBANK_PUBLIC_KEY=${NEXT_PUBLIC_PAGBANK_PUBLIC_KEY}

# Chave estável para os IDs/criptografia das Server Actions. Sem ela, cada build
# gera IDs novos e abas abertas quebram com "Failed to find Server Action".
ARG NEXT_SERVER_ACTIONS_ENCRYPTION_KEY
ENV NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=${NEXT_SERVER_ACTIONS_ENCRYPTION_KEY}

COPY package*.json ./
COPY prisma ./prisma/

RUN npm install --legacy-peer-deps

COPY . .

RUN npx prisma generate
RUN npm run build

# Production stage
FROM node:20-alpine

WORKDIR /app

ENV NODE_ENV=production

# pg_dump/pg_restore e o tar GNU sustentam o backup e a restauracao feitos pela
# tela de Configuracoes. O pacote "postgresql-client" generico do Alpine 3.23
# resolve para o cliente 17, cujo pg_restore envia "SET transaction_timeout"
# no preludio -- parametro que so existe a partir do Postgres 17 e quebra a
# restauracao contra o Postgres 15 do docker-compose.yml com o erro
# "unrecognized configuration parameter". O cliente 16 nao manda esse SET e
# ainda assim e igual ou mais novo que o servidor, a combinacao suportada
# oficialmente pelo pg_dump/pg_restore.
RUN apk add --no-cache postgresql16-client tar

# Diretorio dos pacotes de backup (volume backups_data no docker-compose).
ENV BACKUP_DIR=/app/backups
RUN mkdir -p /app/backups

# Environment variables for runtime
ENV INTERNAL_API_URL=http://api:3001/api
ENV NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Mesma chave usada no build, agora em runtime (precisa ser idêntica).
ARG NEXT_SERVER_ACTIONS_ENCRYPTION_KEY
ENV NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=${NEXT_SERVER_ACTIONS_ENCRYPTION_KEY}

# Copy standalone output (includes server.js and minimal node_modules)
COPY --from=builder /app/.next/standalone ./

# Copy static assets (standalone does NOT include these)
COPY --from=builder /app/.next/static ./.next/static

# Copy public folder
COPY --from=builder /app/public ./public

# Copy prisma schema (needed for runtime prisma client)
COPY --from=builder /app/prisma ./prisma

# The Prisma CLI is required at startup to keep the production schema in sync.
COPY --from=builder /app/node_modules ./node_modules

EXPOSE 3000

CMD ["sh", "-c", "npx prisma db push && node server.js"]
